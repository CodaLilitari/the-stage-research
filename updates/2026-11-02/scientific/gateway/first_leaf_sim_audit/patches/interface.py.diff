+        elif byte == 0x22:
+            in_string = True
+        elif byte in (0x5B, 0x7B):  # [ or {
+            depth += 1
+            if depth > MAX_NESTING:
+                raise ValueError("Request nesting too deep")
+        elif byte in (0x5D, 0x7D):  # ] or }
