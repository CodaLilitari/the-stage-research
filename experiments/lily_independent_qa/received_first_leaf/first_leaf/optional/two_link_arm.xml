<mujoco model="stage_two_link_arm_candidate">
  <compiler angle="radian"/>
  <option timestep="0.01" gravity="0 0 0" integrator="implicitfast"/>
  <default>
    <joint type="hinge" axis="0 0 1" damping="0.2" armature="0.01"/>
    <geom type="capsule" size="0.035" contype="0" conaffinity="0"/>
    <motor ctrllimited="true" ctrlrange="-2 2"/>
  </default>
  <worldbody>
    <body name="upper_arm" pos="0 0 0.2">
      <joint name="shoulder" limited="true" range="-2.6 2.6"/>
      <geom name="upper_link" fromto="0 0 0 0.5 0 0" mass="1"/>
      <body name="forearm" pos="0.5 0 0">
        <joint name="elbow" limited="true" range="-2.6 2.6"/>
        <geom name="lower_link" fromto="0 0 0 0.4 0 0" mass="0.7"/>
        <site name="tip" pos="0.4 0 0" size="0.025"/>
      </body>
    </body>
    <site name="target" pos="0.55 0.3 0.2" size="0.025"/>
  </worldbody>
  <actuator>
    <motor name="shoulder_torque" joint="shoulder"/>
    <motor name="elbow_torque" joint="elbow"/>
  </actuator>
</mujoco>
